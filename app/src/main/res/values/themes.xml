<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tsuki" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryVariant">@color/gold_soft</item>
        <item name="colorOnPrimary">@color/on_gold</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/on_gold</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="materialButtonStyle">@style/Widget.Tsuki.Button</item>
    </style>

    <style name="Theme.Tsuki.Splash" parent="Theme.Tsuki" />

    <style name="Theme.Tsuki.Call" parent="Theme.Tsuki">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Widget.Tsuki.DialKey" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Tsuki.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/on_gold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Tsuki.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/gold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/gold_soft</item>
    </style>
</resources>
